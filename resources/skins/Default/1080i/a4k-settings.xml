<?xml version="1.0" encoding="UTF-8"?>
<!--
  a4kStreaming settings (tvOS-like). The same rules as a4k-home.xml: 1080p pixels = reference app units x2, no includes
  and no named colours, Estuary font names, every control places itself (left/top).

  A rail of categories on the left, the current category's rows on the right, both filled from Python
  (a4kStreaming/ui/settings.py). Up/Down on the rail switches the pane at once; Right or OK enters it. Python owns
  Left/Right in the pane (it steps an option or a number, or goes back to the rail), so the pane's edges say noop; Up and
  Down stop at the ends. The selected item of a list that has no focus keeps its focusedlayout, so the highlight shows
  only while the list has focus; the rail's current category keeps a faint fill.

  Row properties: a4k.step (Left/Right change the value: drawn as < value >), a4k.off (needs the IMDb login: dimmed),
  a4k.grabbed (the Home order row being moved: lifted further), a4k.help (the line under the pane).
  No defaultcontrol: the lists are empty when the window inits; onInit fills them and then focuses one.
-->
<window>
	<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="FF07080C">a4k/white.png</texture>
		</control>
		<control type="label">
			<left>0</left>
			<top>52</top>
			<width>1920</width>
			<height>88</height>
			<font>font52_title</font>
			<align>center</align>
			<aligny>center</aligny>
			<textcolor>FFFFFFFF</textcolor>
			<label>Settings</label>
		</control>
		<control type="list" id="100">
			<left>128</left>
			<top>172</top>
			<width>440</width>
			<height>640</height>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<onup>noop</onup>
			<ondown>noop</ondown>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">220</scrolltime>
			<itemlayout width="440" height="88">
				<control type="label">
					<left>32</left>
					<top>0</top>
					<width>376</width>
					<height>88</height>
					<font>font32_title</font>
					<aligny>center</aligny>
					<textcolor>B8FFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout width="440" height="88">
				<control type="group">
					<left>0</left>
					<top>0</top>
					<animation effect="zoom" start="100" end="103" time="220" tween="cubic" easing="out" center="220,44" condition="Control.HasFocus(100)">Conditional</animation>
					<control type="image">
						<left>4</left>
						<top>4</top>
						<width>432</width>
						<height>80</height>
						<texture border="20" colordiffuse="FFF5F6FA">a4k/rr20.png</texture>
						<visible>Control.HasFocus(100)</visible>
					</control>
					<control type="image">
						<left>4</left>
						<top>4</top>
						<width>432</width>
						<height>80</height>
						<texture border="20" colordiffuse="24FFFFFF">a4k/rr20.png</texture>
						<visible>!Control.HasFocus(100)</visible>
					</control>
					<control type="label">
						<left>32</left>
						<top>0</top>
						<width>376</width>
						<height>88</height>
						<font>font32_title</font>
						<aligny>center</aligny>
						<textcolor>FF0C0D12</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>Control.HasFocus(100)</visible>
					</control>
					<control type="label">
						<left>32</left>
						<top>0</top>
						<width>376</width>
						<height>88</height>
						<font>font32_title</font>
						<aligny>center</aligny>
						<textcolor>FFFFFFFF</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Control.HasFocus(100)</visible>
					</control>
				</control>
			</focusedlayout>
		</control>
		<control type="label">
			<left>680</left>
			<top>172</top>
			<width>1112</width>
			<height>44</height>
			<font>font27</font>
			<textcolor>80FFFFFF</textcolor>
			<label>$INFO[Window.Property(a4k.desc)]</label>
		</control>
		<control type="list" id="200">
			<left>640</left>
			<top>224</top>
			<width>1152</width>
			<height>704</height>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<onup>noop</onup>
			<ondown>noop</ondown>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">220</scrolltime>
			<itemlayout width="1152" height="88">
				<control type="label">
					<left>40</left>
					<top>0</top>
					<width>660</width>
					<height>88</height>
					<font>font30_title</font>
					<aligny>center</aligny>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>String.IsEmpty(ListItem.Property(a4k.off))</visible>
				</control>
				<control type="label">
					<left>40</left>
					<top>0</top>
					<width>660</width>
					<height>88</height>
					<font>font30_title</font>
					<aligny>center</aligny>
					<textcolor>47FFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>!String.IsEmpty(ListItem.Property(a4k.off))</visible>
				</control>
				<control type="label">
					<left>712</left>
					<top>0</top>
					<width>400</width>
					<height>88</height>
					<font>font27</font>
					<align>right</align>
					<aligny>center</aligny>
					<textcolor>8CFFFFFF</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>
			<focusedlayout width="1152" height="88">
				<control type="group">
					<left>0</left>
					<top>0</top>
					<animation effect="zoom" start="100" end="103" time="220" tween="cubic" easing="out" center="576,44" condition="Control.HasFocus(200)">Conditional</animation>
					<animation effect="zoom" start="100" end="104" time="220" tween="cubic" easing="out" center="576,44" condition="Control.HasFocus(200) + !String.IsEmpty(ListItem.Property(a4k.grabbed))">Conditional</animation>
					<control type="image">
						<left>8</left>
						<top>4</top>
						<width>1136</width>
						<height>80</height>
						<texture border="20" colordiffuse="FFF5F6FA">a4k/rr20.png</texture>
						<visible>Control.HasFocus(200)</visible>
					</control>
					<control type="image">
						<left>-8</left>
						<top>-8</top>
						<width>1168</width>
						<height>104</height>
						<texture border="48" colordiffuse="99000000">a4k/shadow.png</texture>
						<visible>Control.HasFocus(200) + !String.IsEmpty(ListItem.Property(a4k.grabbed))</visible>
					</control>
					<control type="image">
						<left>8</left>
						<top>4</top>
						<width>1136</width>
						<height>80</height>
						<texture border="20" colordiffuse="FFFFFFFF">a4k/rr20.png</texture>
						<visible>Control.HasFocus(200) + !String.IsEmpty(ListItem.Property(a4k.grabbed))</visible>
					</control>
					<control type="label">
						<left>40</left>
						<top>0</top>
						<width>660</width>
						<height>88</height>
						<font>font30_title</font>
						<aligny>center</aligny>
						<textcolor>FF0C0D12</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>Control.HasFocus(200)</visible>
					</control>
					<control type="label">
						<left>40</left>
						<top>0</top>
						<width>660</width>
						<height>88</height>
						<font>font30_title</font>
						<aligny>center</aligny>
						<textcolor>FFFFFFFF</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Control.HasFocus(200) + String.IsEmpty(ListItem.Property(a4k.off))</visible>
					</control>
					<control type="label">
						<left>40</left>
						<top>0</top>
						<width>660</width>
						<height>88</height>
						<font>font30_title</font>
						<aligny>center</aligny>
						<textcolor>47FFFFFF</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Control.HasFocus(200) + !String.IsEmpty(ListItem.Property(a4k.off))</visible>
					</control>
					<control type="label">
						<left>712</left>
						<top>0</top>
						<width>400</width>
						<height>88</height>
						<font>font27</font>
						<align>right</align>
						<aligny>center</aligny>
						<textcolor>8C0C0D12</textcolor>
						<label>$INFO[ListItem.Label2]</label>
						<visible>Control.HasFocus(200) + String.IsEmpty(ListItem.Property(a4k.step))</visible>
					</control>
					<control type="label">
						<left>712</left>
						<top>0</top>
						<width>400</width>
						<height>88</height>
						<font>font27</font>
						<align>right</align>
						<aligny>center</aligny>
						<textcolor>B30C0D12</textcolor>
						<label>‹   $INFO[ListItem.Label2]   ›</label>
						<visible>Control.HasFocus(200) + !String.IsEmpty(ListItem.Property(a4k.step))</visible>
					</control>
					<control type="label">
						<left>712</left>
						<top>0</top>
						<width>400</width>
						<height>88</height>
						<font>font27</font>
						<align>right</align>
						<aligny>center</aligny>
						<textcolor>8CFFFFFF</textcolor>
						<label>$INFO[ListItem.Label2]</label>
						<visible>!Control.HasFocus(200)</visible>
					</control>
				</control>
			</focusedlayout>
		</control>
		<control type="textbox">
			<left>680</left>
			<top>948</top>
			<width>1072</width>
			<height>80</height>
			<font>font12</font>
			<textcolor>80FFFFFF</textcolor>
			<label>$INFO[Container(200).ListItem.Property(a4k.help)]</label>
			<visible>Control.HasFocus(200)</visible>
		</control>
	</controls>
</window>
