<?xml version="1.0" encoding="UTF-8"?>
<!--
  a4kStreaming title detail (tvOS-like). The same rules as a4k-home.xml: 1080p pixels = the TV skin's units x2, no includes and
  no named colours, Estuary font names, every control places itself (left/top), every focusable control names its
  neighbours and says noop at its edges, and the one <content> row sorts by programcount so play and stop do not reload
  it.

  The text is window properties: painted from the selected card before the window opens, then from the title's own
  request. The season pills and the cast are filled from Python; the episodes shelf is the plugin's episodes listing for
  the open season (a4k.episodes, set once a pill keeps focus), its cards read the listing's a4k.* episode properties
  (listing.episode_properties). The blurred backdrop (the 64x36 still, stretched) fades in once focus leaves the
  buttons, as the TV skin's glass does. A focused episode with a plot shows its label, title and plot in a glass panel
  on the right, and the title's info and buttons fade out under it.
-->
<window>
	<!-- the row's first shown button: a series has no Play -->
	<defaultcontrol>500</defaultcontrol>
	<backgroundcolor>FF07080C</backgroundcolor>
	<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<aspectratio aligny="top">scale</aspectratio>
			<fadetime>700</fadetime>
			<texture background="true">$INFO[Window.Property(a4k.fanart)]</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>300</fadetime>
			<texture background="true" colordiffuse="FFCCCCCC">$INFO[Window.Property(a4k.blur)]</texture>
			<visible>!ControlGroup(500).HasFocus + !Control.HasFocus(510)</visible>
			<animation effect="fade" time="300">VisibleChange</animation>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture>a4k/scrim_left.png</texture>
