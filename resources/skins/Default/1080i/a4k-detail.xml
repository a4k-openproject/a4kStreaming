		</control>
		<control type="grouplist" id="100">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<orientation>vertical</orientation>
			<itemgap>0</itemgap>
			<scrolltime tween="cubic" easing="out">320</scrolltime>
			<usecontrolcoords>true</usecontrolcoords>

			<!-- The info, bottom-aligned above the buttons at y 644: a one-line title leaves no gap. -->
