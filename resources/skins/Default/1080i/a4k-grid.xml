<?xml version="1.0" encoding="UTF-8"?>
<!--
  a4kStreaming browse grid (tvOS-like). The same rules as a4k-home.xml: 1080p pixels = dobby units x2, no includes and
  no named colours, Estuary font names, every control places itself (left/top), the panel says noop at its edges (a
  container without an edge action wraps), and its <content> sorts by programcount so play and stop do not reload it.

  The panel is the plugin's own listing at a4k.path (lists, watchlist, recommended, a year, search results, more like
  this, known for). Python only swaps that path: the listing's Next item for the next page, a list or a person in place,
  Back for the step before. The panel is always visible: a hidden container never takes the items its provider fetched
  (spike 2b). Its no-op onclick keeps Kodi from opening or playing the item itself; Python handles the click (spike 2c).

  Six columns of 248 x 372 posters in 296 x 468 slots (dobby's browse grid, 124u posters), captions as on home. Items
  with no a4k.type (the Next item, the user's lists) are drawn as tiles: per-item <visible> on two groups in one layout,
  because an itemlayout's condition is checked once for the whole panel, not per item (seen live: every item a tile).
-->
<window>
	<defaultcontrol>500</defaultcontrol>
	<backgroundcolor>FF000000</backgroundcolor>
	<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
	<controls>
		<control type="label">
			<left>96</left>
			<top>44</top>
			<width>1300</width>
			<height>34</height>
			<font>font25_title</font>
			<textcolor>B8FFFFFF</textcolor>
			<label>$INFO[Window.Property(a4k.kicker)]</label>
		</control>
		<control type="label">
			<left>96</left>
			<top>76</top>
			<width>1300</width>
			<height>60</height>
			<font>font45_title</font>
			<textcolor>FFFFFFFF</textcolor>
			<label>$INFO[Window.Property(a4k.title)]</label>
		</control>
		<control type="label">
			<left>1424</left>
			<top>88</top>
			<width>400</width>
			<height>40</height>
			<font>font27</font>
			<textcolor>B8FFFFFF</textcolor>
			<align>right</align>
			<label>$INFO[Window.Property(a4k.page)]</label>
		</control>
		<control type="label">
			<left>96</left>
			<top>480</top>
			<width>1728</width>
			<height>60</height>
			<font>font30_title</font>
			<textcolor>80FFFFFF</textcolor>
			<align>center</align>
			<label>Loading…</label>
			<visible>Container(500).IsUpdating + Integer.IsEqual(Container(500).NumItems,0)</visible>
		</control>
		<control type="label">
			<left>96</left>
			<top>480</top>
			<width>1728</width>
			<height>60</height>
			<font>font30_title</font>
			<textcolor>80FFFFFF</textcolor>
			<align>center</align>
			<label>Nothing here</label>
			<visible>!Container(500).IsUpdating + Integer.IsEqual(Container(500).NumItems,0)</visible>
		</control>
		<control type="panel" id="500">
			<onup>noop</onup>
			<ondown>noop</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<left>72</left>
			<top>140</top>
			<width>1776</width>
			<height>940</height>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">320</scrolltime>
			<preloaditems>2</preloaditems>
			<onclick>SetProperty(a4k.click,500)</onclick>
			<itemlayout width="296" height="468">
						<control type="group">
							<left>0</left>
							<top>0</top>
							<visible>String.IsEmpty(ListItem.Property(a4k.type))</visible>
							<control type="image">
								<left>24</left>
								<top>20</top>
								<width>248</width>
								<height>372</height>
								<texture border="24" colordiffuse="FF26262A">a4k/rr24.png</texture>
							</control>
							<control type="label">
								<left>48</left>
								<top>20</top>
								<width>200</width>
								<height>372</height>
								<font>font30_title</font>
								<textcolor>FFFFFFFF</textcolor>
								<align>center</align>
								<aligny>center</aligny>
								<wrapmultiline>true</wrapmultiline>
								<label>$INFO[ListItem.Label]</label>
							</control>
						</control>
						<control type="group">
							<left>0</left>
							<top>0</top>
							<visible>!String.IsEmpty(ListItem.Property(a4k.type))</visible>
							<control type="image">
								<left>24</left>
								<top>20</top>
								<width>248</width>
								<height>372</height>
								<texture>a4k/placeholder_poster.png</texture>
							</control>
							<control type="image">
								<left>24</left>
								<top>20</top>
								<width>248</width>
								<height>372</height>
								<aspectratio scalediffuse="false">scale</aspectratio>
								<fadetime>200</fadetime>
								<texture background="true" diffuse="a4k/mask_poster.png">$INFO[ListItem.Art(poster)]</texture>
							</control>
							<control type="label">
								<left>24</left>
								<top>404</top>
								<width>248</width>
								<height>34</height>
								<font>font12</font>
								<textcolor>80FFFFFF</textcolor>
								<label>$INFO[ListItem.Label]</label>
							</control>
							<control type="label">
								<left>24</left>
								<top>438</top>
								<width>248</width>
								<height>28</height>
								<font>font10</font>
								<textcolor>59FFFFFF</textcolor>
								<label>$INFO[ListItem.Year]$INFO[ListItem.Rating,  ·  IMDb ,]</label>
							</control>
						</control>
			</itemlayout>
			<focusedlayout width="296" height="468">
						<control type="group">
							<left>0</left>
							<top>0</top>
							<visible>String.IsEmpty(ListItem.Property(a4k.type))</visible>
							<animation effect="zoom" start="100" end="106" time="220" tween="cubic" easing="out" center="148,206" reversible="false">Focus</animation>
							<animation effect="zoom" start="106" end="100" time="220" tween="cubic" easing="out" center="148,206" reversible="false">Unfocus</animation>
							<control type="image">
								<left>24</left>
								<top>20</top>
								<width>248</width>
								<height>372</height>
								<texture border="24" colordiffuse="FF26262A">a4k/rr24.png</texture>
							</control>
							<control type="image">
								<left>24</left>
								<top>20</top>
								<width>248</width>
								<height>372</height>
								<texture border="24" colordiffuse="FFF5F6FA">a4k/rr24.png</texture>
								<visible>Control.HasFocus(500)</visible>
							</control>
							<control type="label">
								<left>48</left>
								<top>20</top>
								<width>200</width>
								<height>372</height>
								<font>font30_title</font>
								<textcolor>FFFFFFFF</textcolor>
								<align>center</align>
								<aligny>center</aligny>
								<wrapmultiline>true</wrapmultiline>
								<label>$INFO[ListItem.Label]</label>
								<visible>!Control.HasFocus(500)</visible>
							</control>
							<control type="label">
								<left>48</left>
								<top>20</top>
								<width>200</width>
								<height>372</height>
								<font>font30_title</font>
								<textcolor>FF0C0D12</textcolor>
								<align>center</align>
								<aligny>center</aligny>
								<wrapmultiline>true</wrapmultiline>
								<label>$INFO[ListItem.Label]</label>
								<visible>Control.HasFocus(500)</visible>
							</control>
						</control>
						<control type="group">
							<left>0</left>
							<top>0</top>
							<visible>!String.IsEmpty(ListItem.Property(a4k.type))</visible>
							<animation effect="zoom" start="100" end="108" time="220" tween="cubic" easing="out" center="148,206" reversible="false">Focus</animation>
							<animation effect="zoom" start="108" end="100" time="220" tween="cubic" easing="out" center="148,206" reversible="false">Unfocus</animation>
							<control type="image">
								<left>-48</left>
								<top>-24</top>
								<width>392</width>
								<height>516</height>
								<texture border="96" colordiffuse="BFFFFFFF">a4k/shadow.png</texture>
								<visible>Control.HasFocus(500)</visible>
							</control>
							<control type="image">
								<left>24</left>
								<top>20</top>
								<width>248</width>
								<height>372</height>
								<texture>a4k/placeholder_poster.png</texture>
							</control>
							<control type="image">
								<left>24</left>
								<top>20</top>
								<width>248</width>
								<height>372</height>
								<aspectratio scalediffuse="false">scale</aspectratio>
								<fadetime>200</fadetime>
								<texture background="true" diffuse="a4k/mask_poster.png">$INFO[ListItem.Art(poster)]</texture>
							</control>
							<control type="image">
								<left>15</left>
								<top>11</top>
								<width>266</width>
								<height>390</height>
								<texture border="40">a4k/ring.png</texture>
								<visible>Control.HasFocus(500)</visible>
							</control>
							<control type="label">
								<left>24</left>
								<top>404</top>
								<width>248</width>
								<height>34</height>
								<font>font12</font>
								<textcolor>FFFFFFFF</textcolor>
								<label>$INFO[ListItem.Label]</label>
							</control>
							<control type="label">
								<left>24</left>
								<top>438</top>
								<width>248</width>
								<height>28</height>
								<font>font10</font>
								<textcolor>B3FFFFFF</textcolor>
								<label>$INFO[ListItem.Year]$INFO[ListItem.Rating,  ·  IMDb ,]</label>
							</control>
						</control>
			</focusedlayout>
			<content target="videos" sortby="programcount">$INFO[Window.Property(a4k.path)]</content>
		</control>
	</controls>
</window>
